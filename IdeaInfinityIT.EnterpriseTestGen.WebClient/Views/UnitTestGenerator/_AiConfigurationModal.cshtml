@model IdeaInfinityIT.EnterpriseTestGen.WebClient.Models.UnitTestGeneratorViewModel

<!-- AI Configuration Modal -->
<div class="modal fade" id="aiConfigModal" tabindex="-1" aria-labelledby="aiConfigModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg border-0 rounded-3">
            <div class="modal-header bg-gradient-primary text-white py-3">
                <div class="d-flex align-items-center gap-2">
                    <i class="ri-brain-line fs-4 text-warning"></i>
                    <h5 class="modal-title fw-bold" id="aiConfigModalLabel">Configure AI Test Engineering Engine</h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="alert alert-info py-2 px-3 small d-flex align-items-center gap-2 mb-3">
                    <i class="ri-information-line fs-5"></i>
                    <span>Connect your preferred AI model to automatically synthesize enterprise boundary cases, null guards, and BRD traceability assertions.</span>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold text-secondary small">AI Engine Provider</label>
                    <select class="form-select form-select-sm" id="aiModalProvider">
                        <option value="LocalHeuristic" selected>🚀 Built-in Semantic AI Engine (Offline / Zero-Config / Instant)</option>
                        <option value="Ollama">🦙 Ollama (Local Private LLM - llama3, deepseek, mistral)</option>
                        <option value="OpenAI">🌐 OpenAI (GPT-4o, GPT-4-turbo, o1)</option>
                        <option value="AzureOpenAI">🏢 Azure OpenAI Service</option>
                        <option value="Gemini">✨ Google Gemini Pro</option>
                    </select>
                </div>

                <div class="mb-3" id="aiEndpointGroup">
                    <label class="form-label fw-semibold text-secondary small">AI API Endpoint URL</label>
                    <input type="text" class="form-control form-control-sm" id="aiModalEndpoint" value="http://localhost:11434" placeholder="e.g. http://localhost:11434 or https://api.openai.com/v1" />
                    <div class="form-text small text-muted">For Ollama default is <code>http://localhost:11434</code>. For OpenAI use <code>https://api.openai.com/v1</code>.</div>
                </div>

                <div class="mb-3" id="aiApiKeyGroup" style="display: none;">
                    <label class="form-label fw-semibold text-secondary small">API Key / Token</label>
                    <input type="password" class="form-control form-control-sm" id="aiModalApiKey" placeholder="sk-..." />
                    <div class="form-text small text-muted">Kept only in your local browser session. Not required for Ollama or Local Heuristic.</div>
                </div>

                <div class="row">
                    <div class="col-md-7 mb-3">
                        <label class="form-label fw-semibold text-secondary small">Model Identifier</label>
                        <input type="text" class="form-control form-control-sm" id="aiModalModel" value="llama3" placeholder="e.g. llama3, gpt-4o, deepseek-coder" />
                    </div>
                    <div class="col-md-5 mb-3">
                        <label class="form-label fw-semibold text-secondary small">Temperature</label>
                        <input type="number" class="form-control form-control-sm" id="aiModalTemp" value="0.2" step="0.1" min="0.0" max="1.0" />
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light py-2">
                <button type="button" class="btn btn-secondary btn-sm rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary btn-sm rounded-pill px-4 fw-semibold" id="btnSaveAiSettings" data-bs-dismiss="modal">
                    <i class="ri-check-line me-1"></i>Apply AI Settings
                </button>
            </div>
        </div>
    </div>
</div>
