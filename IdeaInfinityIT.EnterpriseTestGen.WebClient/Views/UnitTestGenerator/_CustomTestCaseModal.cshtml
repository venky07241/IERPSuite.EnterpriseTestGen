<!-- Interactive Custom Test Case Builder Modal (Step 6) -->
<div class="modal fade" id="customTestCaseModal" tabindex="-1" aria-labelledby="customTestCaseModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content shadow-lg border-0 rounded-3">
            <div class="modal-header bg-gradient-primary text-white py-3">
                <div class="d-flex align-items-center gap-2">
                    <i class="ri-file-add-fill fs-3 text-warning"></i>
                    <div>
                        <h5 class="modal-title fw-bold mb-0" id="customTestCaseModalLabel">Custom Test Case Builder</h5>
                        <span class="small text-white-50">Define Arrange inputs, preconditions, mock behaviors & assertions without writing C#</span>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            <div class="modal-body p-4">
                <form id="frmCustomTestCase">
                    <input type="hidden" id="editTestCaseId" value="" />
                    <div class="row g-3">
                        <div class="col-md-7">
                            <label class="form-label small fw-bold text-dark">Test Case Name *</label>
                            <input type="text" class="form-control form-control-sm" id="modalCaseName" placeholder="e.g. GetAllPurchaseOrder_WhenValidStatus_ReturnsList" required />
                        </div>
                        <div class="col-md-5">
                            <label class="form-label small fw-bold text-dark">Category</label>
                            <select class="form-select form-select-sm" id="modalCaseCategory">
                                <option value="HappyPath">Happy Path (Positive)</option>
                                <option value="NullValidation">Null Guard / Defensive</option>
                                <option value="Boundary">Boundary / Range Value</option>
                                <option value="Exception">Exception Handling</option>
                                <option value="BRD">BRD Business Rule</option>
                                <option value="CustomUser">Custom User Scenario</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-dark">Target Project / Role</label>
                            <select class="form-select form-select-sm" id="modalCaseProjectRole">
                                <option value="Web MVC">Web Client (MVC Controller / Service)</option>
                                <option value="Core API" selected>Core Server (Web API / Service)</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-dark">Priority</label>
                            <select class="form-select form-select-sm" id="modalCasePriority">
                                <option value="High" selected>High (Mandatory Release Gate)</option>
                                <option value="Medium">Medium</option>
                                <option value="Low">Low</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-dark">Target Class *</label>
                            <input type="text" class="form-control form-control-sm" id="modalCaseTargetClass" placeholder="e.g. PurchaseOrderBaseController" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-dark">Target Method *</label>
                            <input type="text" class="form-control form-control-sm" id="modalCaseTargetMethod" placeholder="e.g. GetAllPurchaseOrderAsync" required />
                        </div>

                        <div class="col-md-12">
                            <label class="form-label small fw-bold text-dark">Arrange: Input Parameters & Preconditions</label>
                            <input type="text" class="form-control form-control-sm font-monospace" id="modalCaseInputs" placeholder="status = 'A', fromDate = '01-01-2025', toDate = '31-01-2025'" />
                            <div class="form-text small text-muted">Comma-separated input parameter values passed to Act call.</div>
                        </div>

                        <div class="col-md-12">
                            <label class="form-label small fw-bold text-dark">Assert: Expected Result & Outcome *</label>
                            <input type="text" class="form-control form-control-sm font-monospace" id="modalCaseExpected" placeholder="Returns OkObjectResult with ServiceResponse containing data" required />
                            <div class="form-text small text-muted">Assertion goal (e.g. Returns 200 OK, Throws ArgumentNullException, Calls IPurchaseOrderService.GetAllOnce).</div>
                        </div>
                    </div>
                </form>
            </div>

            <div class="modal-footer bg-light py-2 d-flex align-items-center justify-content-between">
                <button type="button" class="btn btn-secondary btn-sm rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary btn-sm rounded-pill px-4 fw-bold shadow-sm" id="btnSaveCustomTestCase" onclick="saveCustomTestCaseFromModal()">
                    <i class="ri-check-line me-1"></i>Save Test Case
                </button>
            </div>
        </div>
    </div>
</div>
