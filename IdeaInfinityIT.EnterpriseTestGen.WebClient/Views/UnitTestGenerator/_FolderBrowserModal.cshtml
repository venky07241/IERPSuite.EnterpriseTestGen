<!-- Interactive Folder / File Path Browser Modal -->
<div class="modal fade" id="folderBrowserModal" tabindex="-1" aria-labelledby="folderBrowserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content shadow-lg border-0 rounded-3">
            <div class="modal-header bg-gradient-primary text-white py-3">
                <div class="d-flex align-items-center gap-2">
                    <i class="ri-folder-open-fill fs-3 text-warning"></i>
                    <div>
                        <h5 class="modal-title fw-bold mb-0" id="folderBrowserModalLabel">Browse Project / File Directory</h5>
                        <span class="small text-white-50">Click into folders to navigate and select your target C# project or service</span>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            <div class="modal-body p-3">
                <!-- Breadcrumb Path & Up Button -->
                <div class="d-flex align-items-center justify-content-between gap-2 mb-3 bg-light p-2 rounded-3 border">
                    <div class="d-flex align-items-center gap-2 text-truncate">
                        <i class="ri-folder-2-fill text-warning fs-5"></i>
                        <span class="font-monospace small fw-bold text-dark text-truncate" id="browserCurrentPathText">No folder selected</span>
                    </div>
                    <div class="d-flex align-items-center gap-1">
                        <button type="button" class="btn btn-outline-secondary btn-sm py-1 px-2 opacity-50" id="btnBrowserGoUp" onclick="navigateParentDirectory()" title="Go to Parent Folder" disabled>
                            <i class="ri-arrow-up-line me-1"></i>Up
                        </button>
                    </div>
                </div>

                <!-- Filter Input -->
                <div class="input-group input-group-sm mb-3">
                    <span class="input-group-text bg-white"><i class="ri-search-line text-muted"></i></span>
                    <input type="text" class="form-control" id="browserFilterInput" placeholder="Filter folders and files in selected directory..." onkeyup="filterDirectoryItems()" />
                </div>

                <!-- Items Container (Folders & Files) -->
                <div class="browser-items-container border rounded-3 p-2 bg-white" style="max-height: 380px; min-height: 250px; overflow-y: auto;">
                    <div class="list-group list-group-flush" id="browserItemsList">
                        <div class="text-center py-5 text-muted">
                            <i class="ri-folder-open-line fs-1 text-secondary mb-2 d-block"></i>
                            <div class="fw-semibold text-dark mb-1">No Folder Selected from System</div>
                            <div class="small text-muted mb-3">Fetch a project folder from your system or enter a local path to inspect.</div>
                            <button type="button" class="btn btn-primary btn-sm rounded-pill px-4 shadow-sm" onclick="$('#browserNativeFolderInput').click()">
                                <i class="ri-folder-upload-line me-1"></i>Fetch Folder from System
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer: Selection Actions -->
            <div class="modal-footer bg-light py-2 d-flex align-items-center justify-content-between">
                <div>
                    <input type="file" id="browserNativeFolderInput" webkitdirectory directory multiple class="d-none" onchange="handleNativeFolderSelection(this)" />
                    <button type="button" class="btn btn-primary btn-sm rounded-pill px-3 fw-semibold shadow-sm" onclick="$('#browserNativeFolderInput').click()">
                        <i class="ri-folder-upload-line me-1"></i>Fetch Folder from System
                    </button>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-secondary btn-sm rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-success btn-sm rounded-pill px-4 fw-bold opacity-50" id="btnSelectCurrentDirectory" onclick="confirmDirectorySelection()" disabled>
                        <i class="ri-checkbox-circle-line me-1"></i>Select This Folder
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
